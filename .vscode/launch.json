{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend API",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/backend/cmd/api",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "SERVER_PORT": "5001",
        "DATABASE_URL": "postgres://cafeos:cafeos@localhost:5432/cafeos?sslmode=disable",
        "REDIS_URL": "redis://localhost:6379",
        "RABBITMQ_URL": "amqp://cafeos:cafeos@localhost:5672/",
        "JWT_SECRET": "dev-secret-change-in-production"
      },
      "buildFlags": "-tags=dev"
    },
    {
      "name": "Backend Worker",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/backend/cmd/worker",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "DATABASE_URL": "postgres://cafeos:cafeos@localhost:5432/cafeos?sslmode=disable",
        "RABBITMQ_URL": "amqp://cafeos:cafeos@localhost:5672/",
        "JWT_SECRET": "dev-secret-change-in-production"
      }
    },
    {
      "name": "Backend Seed",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/apps/backend/cmd/seed",
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "DATABASE_URL": "postgres://cafeos:cafeos@localhost:5432/cafeos?sslmode=disable",
        "JWT_SECRET": "dev-secret-change-in-production"
      }
    },
    {
      "name": "Admin Panel",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/apps/admin",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Frontend",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/apps/frontend",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Mobile",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "cwd": "${workspaceFolder}/apps/mobile",
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "URL:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ],
  "compounds": [
    {
      "name": "API + Admin Panel",
      "configurations": ["Backend API", "Admin Panel"]
    },
    {
      "name": "API + Frontend",
      "configurations": ["Backend API", "Frontend"]
    },
    {
      "name": "Full Stack",
      "configurations": ["Backend API", "Admin Panel", "Frontend"]
    },
    {
      "name": "All Services",
      "configurations": [
        "Backend API",
        "Backend Worker",
        "Admin Panel",
        "Frontend",
        "Mobile"
      ]
    }
  ]
}
